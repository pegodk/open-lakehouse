# Unity Catalog
UC_SERVER_URL=http://localhost:8080/api/2.1/unity-catalog
CATALOG_NAME=main

# Storage (MinIO / S3-compatible)
STORAGE_ROOT=s3a://lakehouse/
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Spark
# Use local[*] for embedded mode (tests, quick iteration)
# Use spark://localhost:7077 for the standalone cluster (docker compose)
SPARK_MASTER=local[*]

# Environment (local | dev | prod)
ENV=local
